{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/janet-duffy",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/janet-duffy/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/images/:path*",
      "destination": "/media/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(logo\\.png|logo\\.svg|og-image\\.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    }
  ]
}
